{
  "name": "nightscout-overlay",
  "version": "0.1.0",
  "description": "Always-on-top transparent glucose overlay that reads from your Nightscout site",
  "main": "src/main.js",
  "author": "Abdullah",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "icons": "node scripts/make-icons.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "cc.aboodthebombs.nightscout-overlay",
    "productName": "Nightscout Overlay",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "assets/icon.png",
      "category": "public.app-category.medical"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "assets/icon.png",
      "category": "Utility"
    },
    "publish": {
      "provider": "github"
    }
  },
  "repository": "github:abdullahlheab/nightscout-overlay"
}
